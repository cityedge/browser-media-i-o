{
  "name": "browser-media-io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser media I/O library development and verification workspace",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "test": "npm run typecheck && npm run test:web",
    "test:web": "playwright test",
    "test:web:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:serve": "vite --config tests/web/vite.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/dom-webcodecs": "0.1.19",
    "@types/node": "^22.0.0",
    "mediabunny": "1.61.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}

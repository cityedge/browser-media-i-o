{
  "name": "browser-media-io",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Browser media probing, decoding, MP4 rendering and standalone MP3 export",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aac": {
      "types": "./dist/aac.d.ts",
      "import": "./dist/aac.js"
    },
    "./mp3": {
      "types": "./dist/mp3.d.ts",
      "import": "./dist/mp3.js"
    },
    "./public": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/mp3",
    "src",
    "docs/API.md",
    "docs/MP3.md",
    "docs/GETTING_STARTED.md",
    "docs/LOCAL_DISTRIBUTION.md",
    "docs/BUILDING.md",
    "docs/SOURCES.md",
    "examples/*.ts",
    "README.md",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "third_party/lamejs/COPYING",
    "third_party/lamejs/COPYING.LESSER",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-mp3.mjs && node scripts/build-browser.mjs",
    "package:browser": "npm run build && node scripts/package-browser.mjs",
    "package:local": "npm run package:browser",
    "package:sources": "node scripts/package-sources.mjs",
    "test:local": "npm run package:browser && npm run fixtures && node scripts/test-local.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "test": "npm run build && npm run typecheck && npm run test:web && npm run test:app",
    "test:web": "playwright test",
    "test:web:ui": "npm run build && playwright test --ui",
    "prepack": "npm run build",
    "test:report": "playwright show-report",
    "test:serve": "node scripts/prepare-web-tests.mjs && vite --config tests/web/vite.config.ts",
    "app:dev": "npm run build && vite --config apps/studio/vite.config.ts",
    "app:build": "npm run build && vite build --config apps/studio/vite.config.ts",
    "app:preview": "vite preview --config apps/studio/vite.config.ts",
    "test:app": "npm run app:build && playwright test --config playwright.app.config.ts",
    "test:mp3": "npm run build && playwright test tests/web/mp3.spec.ts",
    "package:mp3": "npm run build && node scripts/package-mp3.mjs",
    "test:release": "npm run build && node scripts/test-release.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@mediabunny/aac-encoder": "1.61.0",
    "@playwright/test": "1.63.0",
    "@types/dom-webcodecs": "0.1.19",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "dependencies": {
    "mediabunny": "1.61.0"
  },
  "peerDependencies": {
    "@mediabunny/aac-encoder": "1.61.0"
  },
  "peerDependenciesMeta": {
    "@mediabunny/aac-encoder": {
      "optional": true
    }
  }
}

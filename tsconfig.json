{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node", "@types/dom-webcodecs"]
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "scripts/**/*.mjs"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node", "@types/dom-webcodecs"]
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "playwright.config.ts", "tests/**/*.ts", "scripts/**/*.mjs", "apps/**/*.ts", "playwright.app.config.ts"],
  "exclude": ["node_modules", "tests/tmp", "tests/fixtures/generated", "apps/studio/dist"]
}
